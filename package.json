{
    "name": "deep-playground-prototype",
    "version": "2016.3.10",
    "description": "",
    "private": true,
    "scripts": {
        "clean": "rimraf dist",
        "start": "npm run serve-watch",
        "prep": "copyfiles analytics.js dist && concat node_modules/material-design-lite/material.min.js node_modules/seedrandom/seedrandom.min.js > dist/lib.js",
        "build-css": "concat node_modules/material-design-lite/material.min.css styles.css > dist/bundle.css",
        "build-darkcss": "concat styles_dark.css > dist/styles_dark.css",
        "build-lightcss": "concat styles.css > dist/styles.css",
        "watch-css": "concat node_modules/material-design-lite/material.min.css  -o dist/bundle.css",
        "build-html": "copyfiles index.html dist",
        "watch-html": "concat index.html -o dist/index.html",
        "build-js": "browserify src/playground.ts -p [tsify]  > dist/bundle.js",
        "watch-js": "watchify src/playground.ts -p [tsify] -v --debug -o dist/bundle.js",
        "build-cnn": "browserify src/cnn.ts -p [tsify] > dist/bundlecnn.js",
        "build-transformer": "browserify src/transformer.ts -p [tsify] > dist/bundletransformer.js",
        "build-rnn": "browserify src/rnn.ts -p [tsify] > dist/bundlernn.js",
        "build-autoencoder": "browserify src/autoencoder.ts -p [tsify] > dist/bundleautoencoder.js",
        "build-gan": "browserify src/gan.ts -p [tsify] > dist/bundlegan.js",
        "build-clustering": "browserify src/clustering.ts -p [tsify] > dist/bundleclustering.js",
        "build-rl": "browserify src/rl.ts -p [tsify] > dist/bundlerl.js",
        "build-dtree": "browserify src/dtree.ts -p [tsify] > dist/bundledtree.js",
        "build-dimred": "browserify src/dimred.ts -p [tsify] > dist/bundledimred.js",
        "build-svm": "browserify src/svm.ts -p [tsify] > dist/bundlesvm.js",
        "build-glm": "browserify src/glm.ts -p [tsify] > dist/bundleglm.js",
        "build-gp": "browserify src/gp.ts -p [tsify] > dist/bundlegp.js",
        "build-diffusion": "browserify src/diffusion.ts -p [tsify] > dist/bundlediffusion.js",
        "build-word2vec": "browserify src/word2vec.ts -p [tsify] > dist/bundleword2vec.js",
        "build-hopfield": "browserify src/hopfield.ts -p [tsify] > dist/bundlehopfield.js",
        "build-genetic": "browserify src/genetic.ts -p [tsify] > dist/bundlegenetic.js",
        "build-som": "browserify src/som.ts -p [tsify] > dist/bundlesom.js",
        "build-bayesnn": "browserify src/bayesnn.ts -p [tsify] > dist/bundlebayesnn.js",
        "build-bandit": "browserify src/bandit.ts -p [tsify] > dist/bundlebandit.js",
        "build-optviz": "browserify src/optviz.ts -p [tsify] > dist/bundleoptviz.js",
        "build-markov": "browserify src/markov.ts -p [tsify] > dist/bundlemarkov.js",
        "build-mcmc": "browserify src/mcmc.ts -p [tsify] > dist/bundlemcmc.js",
        "build-ca": "browserify src/ca.ts -p [tsify] > dist/bundleca.js",
        "build-fourier": "browserify src/fourier.ts -p [tsify] > dist/bundlefourier.js",
        "build-kalman": "browserify src/kalman.ts -p [tsify] > dist/bundlekalman.js",
        "build-rbm": "browserify src/rbm.ts -p [tsify] > dist/bundlerbm.js",
        "build-vae": "browserify src/vae.ts -p [tsify] > dist/bundlevae.js",
        "build-pso": "browserify src/pso.ts -p [tsify] > dist/bundlepso.js",
        "build-snn": "browserify src/snn.ts -p [tsify] > dist/bundlesnn.js",
        "build-rd": "browserify src/rd.ts -p [tsify] > dist/bundlerd.js",
        "build-labs": "npm run build-cnn && npm run build-transformer && npm run build-rnn && npm run build-autoencoder && npm run build-gan && npm run build-clustering && npm run build-rl && npm run build-dtree && npm run build-dimred && npm run build-svm && npm run build-glm && npm run build-gp && npm run build-diffusion && npm run build-word2vec && npm run build-hopfield && npm run build-genetic && npm run build-som && npm run build-bayesnn && npm run build-bandit && npm run build-optviz && npm run build-markov && npm run build-mcmc && npm run build-ca && npm run build-fourier && npm run build-kalman && npm run build-rbm && npm run build-vae && npm run build-pso && npm run build-snn && npm run build-rd && copyfiles -f \"labs/*.html\" dist",
        "build": "npm run prep && npm run build-js && npm run build-css && npm run build-darkcss && npm run build-lightcss && npm run build-html",
        "build-all": "npm run build && npm run build-labs",
        "watch": "npm run prep && concurrently \"npm run watch-js\" \"npm run watch-css\" \"npm run watch-html\"",
        "serve": "npx serve dist/",
        "serve-watch": "concurrently \"npx serve dist/\" \"npm run watch\"",
        "test": "jest",
        "test:e2e": "playwright test",
        "test:labs": "node scripts/smoke-labs.js"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@types/d3": "^7.4.3",
        "@types/jest": "^30.0.0",
        "@types/three": "^0.184.1",
        "concat": "^1.0.3",
        "concurrently": "9.0.1",
        "copyfiles": "2.4.1",
        "esmify": "^2.1.1",
        "jest": "^30.4.2",
        "jsdom": "^29.1.1",
        "rimraf": "6.0.1",
        "serve": "^14.2.3",
        "ts-jest": "^29.4.11",
        "tsify": "^5.0.4",
        "typescript": "^5.6",
        "uglify-js": "^3.19.3",
        "watchify": "^4.0.0"
    },
    "dependencies": {
        "d3": "^7.4.4",
        "material-design-lite": "^1.3.0",
        "mathjs": "^13.1.1",
        "seedrandom": "^3.0.5",
        "three": "^0.184.0"
    },
    "browser": {
        "d3": "./node_modules/d3/dist/d3.min.js"
    }
}
